# Copy to .env and fill in values.

# ── Supabase ──
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# ── Stripe Payment Links ──
# Run: npm run stripe:setup-wws  (requires STRIPE_SECRET_KEY from WWS Stripe account)
VITE_PUBLIC_STRIPE_RESERVATION_LINK="https://buy.stripe.com/..."
VITE_PUBLIC_STRIPE_BALANCE_LINK="https://buy.stripe.com/..."

# ── GoHighLevel scheduling ──
VITE_PUBLIC_GHL_MATCH_CALL_URL=""
VITE_PUBLIC_GHL_VIDEO_CALL_URL=""

# ── Google Ads conversion tracking ──
VITE_GOOGLE_ADS_ID="AW-18361383450"
VITE_GADS_LABEL_DEPOSIT=""
VITE_GADS_LABEL_APPLICATION=""
VITE_GADS_LABEL_WAITLIST=""
VITE_GADS_LABEL_CONTACT=""

# ── Optional GA4 (Lovable connector) ──
# VITE_LOVABLE_CONNECTOR_GOOGLE_ANALYTICS_API_KEY="G-XXXXXXXXXX"
